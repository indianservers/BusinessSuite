{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "main.py": {
      "maxDuration": 300,
      "excludeFiles": "{venv/**,.venv/**,.local/**,tests/**,backups/**,uploads/**,alembic/**,**/__pycache__/**,**/tests/**}"
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}

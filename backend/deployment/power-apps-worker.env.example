# Power Apps worker process overrides. Merge with the API's existing protected
# DATABASE_URL, SECRET_KEY, installed-module and production settings.
# Keep credentials in the deployment secret store; this file contains none.
# Start from backend: python -m app.apps.power_apps.worker --poll-seconds 1
# Multiple supervised processes provide concurrency. No process starts implicitly.
POWER_RUNTIME_TENANT_ACTIVE=20
POWER_RUNTIME_ENVIRONMENT_ACTIVE=10
POWER_RUNTIME_TENANT_QUEUE=2000
# Each worker processes one local action at a time. Budget DB pools per process.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0

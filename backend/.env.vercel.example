ENVIRONMENT=production
SERVERLESS=true
DEBUG=false
DATABASE_AUTO_MIGRATE=false
SEED_DEMO_DATA=false
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLER-HOST/neondb?sslmode=require
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
REFRESH_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_A_THIRD_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BACKEND_PUBLIC_URL=https://YOUR-APP.vercel.app
FRONTEND_PUBLIC_URL=https://YOUR-APP.vercel.app
BACKEND_CORS_ORIGINS=["https://YOUR-APP.vercel.app"]
STORAGE_BACKEND=vercel_blob
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_PRIVATE_BLOB_STORE_TOKEN
# Alternative: STORAGE_BACKEND=s3 with the S3 fields below.
S3_BUCKET=YOUR-PRIVATE-BUCKET
S3_ENDPOINT_URL=https://YOUR-ACCOUNT.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
S3_PREFIX=business-suite-production
UPLOAD_DIR=/tmp/business-suite-uploads
MAX_UPLOAD_SIZE_MB=3
REALTIME_TRANSPORT=database
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_BEFORE_ONE_TIME_PROVISIONING

# Application
PROJECT_NAME="AI HRMS"
API_V1_STR="/api/v1"
DEBUG=false
ENVIRONMENT=production
INSTALLED_APPS=hrms,crm,project_management,srm,fam

# Security
SECRET_KEY=your-256-bit-secret-key-here-change-in-production
SECRET_KEY_PREVIOUS=
REFRESH_SECRET_KEY=your-refresh-secret-key-here-change-in-production
REFRESH_SECRET_KEY_PREVIOUS=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database — PostgreSQL for local and remote environments.
# URL passwords must be percent-encoded; discrete POSTGRES_* fields handle raw passwords.
DATABASE_URL=
POSTGRES_USER=business_suite
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=business_suite
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=
# Remote example: postgresql+psycopg://user:encoded-password@host:5432/business_suite?sslmode=verify-full
# Disable automatic migrations in production and run `alembic upgrade head` at deploy time.
DATABASE_AUTO_MIGRATE=true
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_EMAIL=admin@aihrms.com
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# Redis
REDIS_URL=redis://localhost:6379/0

# Email
MAIL_USERNAME=noreply@yourcompany.com
MAIL_PASSWORD=email_password
MAIL_FROM=noreply@yourcompany.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png

# AI / OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini
AI_AGENT_DEFAULT_TEMPERATURE=0.2
AI_AGENT_MAX_TOOL_CALLS=8
AI_AGENT_ENABLE_STREAMING=false
AI_AGENT_AUDIT_LOGGING=true
ANTHROPIC_API_KEY=your-anthropic-key

# CORS
BACKEND_PUBLIC_URL=https://api.yourdomain.com
FRONTEND_PUBLIC_URL=https://hrms.yourdomain.com
BACKEND_CORS_ORIGINS=["https://hrms.yourdomain.com","http://localhost:5173"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Celery
# Recovery: durable server/worker only, outside UPLOAD_DIR and the Git checkout.
# Serverless deployments must run the scheduled CLI on a durable worker with SERVERLESS=false.
BUSINESSSUITE_BACKUP_SCHEDULER=false
BUSINESSSUITE_BACKUP_DIR=
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Kolkata

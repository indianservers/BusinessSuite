# Save as %LOCALAPPDATA%\Business Suite\.env
# Use a PostgreSQL application login provisioned for this desktop installation.
BUSINESS_SUITE_POSTGRES=Host=127.0.0.1;Port=5432;Database=business_suite;Username=admin@yourcompany.example;SSL Mode=Disable
BUSINESS_SUITE_POSTGRES_EXPECTED_ADDRESS=127.0.0.1
BUSINESS_SUITE_ORGANIZATION_ID=1
# BUSINESS_SUITE_BRANCH_ID=1
# Optional absolute directory for retained documents. Defaults to %LOCALAPPDATA%\Business Suite\uploads.
# BUSINESS_SUITE_UPLOAD_DIR=\\fileserver\BusinessSuiteDocuments

ENVIRONMENT=production
DEBUG=false
SERVERLESS=false
DATABASE_AUTO_MIGRATE=false
SEED_DEMO_DATA=false
DATABASE_URL=postgresql+psycopg://business_suite:URL_ENCODED_PASSWORD@127.0.0.1:5432/business_suite
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
REFRESH_SECRET_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CRON_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
FRONTEND_PUBLIC_URL=https://suite.example.com
BACKEND_PUBLIC_URL=https://suite.example.com
BACKEND_CORS_ORIGINS=["https://suite.example.com","https://interns.example.com"]
SECURITY_TRUSTED_PROXY_CIDRS=127.0.0.1/32
STORAGE_BACKEND=local
UPLOAD_DIR=/srv/business-suite/shared/uploads
REALTIME_TRANSPORT=websocket
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
EMAIL_WORKER_ENABLED=true
EMAIL_PROVIDER=auto
EMAIL_NOTIFICATIONS_ENABLED=false
BUSINESSSUITE_BACKUP_SCHEDULER=false


# WhatsApp Cloud API: set independently for every deployment; keep secrets server-side.
CRM_WHATSAPP_PROVIDER=mock
CRM_WHATSAPP_ACCESS_TOKEN=
CRM_WHATSAPP_PHONE_NUMBER_ID=
CRM_WHATSAPP_BUSINESS_ACCOUNT_ID=
CRM_WHATSAPP_API_VERSION=v26.0
CRM_WHATSAPP_APP_SECRET=
CRM_WHATSAPP_VERIFY_TOKEN=
# Set the company ID authorized to use this deployment's sender before enabling meta.
# CRM_WHATSAPP_ORGANIZATION_ID=1

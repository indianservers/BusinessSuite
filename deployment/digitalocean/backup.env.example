# Private DigitalOcean Space, preferably in a different region from the Droplet.
# This file is read only by operations.py, not the application settings.
BACKUP_BUCKET=replace-with-private-space
BACKUP_ENDPOINT=https://blr1.digitaloceanspaces.com
BACKUP_REGION=blr1
BACKUP_ACCESS_KEY_ID=replace-me
BACKUP_SECRET_ACCESS_KEY=replace-me
BACKUP_PREFIX=business-suite/recovery
